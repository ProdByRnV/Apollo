root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,in}]
indent_size = 4
max_line_length = 120

[*.{js,jsx,ts,tsx,css,scss,html,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[Makefile]
indent_style = tab
