# Normalise line endings so that a checkout on Windows, macOS and Linux produces
# byte-identical source files. Without this, CI diffs and clang-format runs
# differ per platform.

* text=auto eol=lf

*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.sh      text eol=lf

# Binary assets: never normalised, never diffed as text.
*.png     binary
*.jpg     binary
*.ico     binary
*.icns    binary
*.wav     binary
*.aiff    binary
*.flac    binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.vst3    binary
